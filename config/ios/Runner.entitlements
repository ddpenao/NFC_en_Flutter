<?xml version="1.0" encoding="UTF-8"?>
<!--
  Archivo: ios/Runner/Runner.entitlements
  Lo crea Xcode automáticamente al agregar la capability
  "Near Field Communication Tag Reading" (Signing & Capabilities > + Capability).
  Requiere cuenta de Apple Developer PAGA.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
